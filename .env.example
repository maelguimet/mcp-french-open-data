# Transport: stdio (default) or http. `--http` on the command line also selects HTTP.
MCP_TRANSPORT=http
# Required for HTTP. Generate one with: openssl rand -hex 32
MCP_API_KEY=
# Set to "none" to serve HTTP without a key (read-only public data; e.g. for ChatGPT).
# MCP_AUTH=none
HOST=127.0.0.1
PORT=3000
# Comma-separated Host header allow-list when binding to 0.0.0.0 behind a proxy.
# ALLOWED_HOSTS=mcp.example.com
LOG_LEVEL=info
